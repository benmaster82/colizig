# Zig build artifacts
.zig-cache/
zig-out/

# Generated by `zig build gen-fixture` (and automatically before `zig build test`)
/test/fixtures/tiny/

# Local reference copies of colibri sources / toolchains, if placed here
/reference/
/_colibri/

# Model checkpoints and anything derived from them - never commit these
/Models/
*.safetensors
*.gguf
.coli_usage
.coli_analysis.json
.colizig_usage

# Secrets / certificates - must never be committed
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.env
/winca.pem

# CUDA backend build artifacts (colizig_cuda.dll lands in zig-out/, ignored above)
*.dll
*.exp
*.lib
*.obj
*.cubin
*.ptx

# Python
__pycache__/
*.pyc

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.orig
